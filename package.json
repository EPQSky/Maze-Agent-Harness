{
  "name": "maze-agent-harness",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @maze-arena/server --filter @maze-arena/web dev",
    "test": "pnpm --filter @maze-arena/contracts --filter @maze-arena/dsh-integration build && pnpm -r test",
    "typecheck": "pnpm --filter @maze-arena/contracts --filter @maze-arena/dsh-integration build && pnpm -r typecheck"
  }
}
