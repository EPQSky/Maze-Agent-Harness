{
  "name": "maze-agent-harness",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "arena": "pnpm --filter @maze-arena/cli start",
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @maze-arena/server --filter @maze-arena/web dev",
    "test": "pnpm --filter @maze-arena/contracts --filter @maze-arena/dsh-integration --filter @maze-arena/engine --filter @maze-arena/generator-plugin --filter @maze-arena/solver-plugin --filter @maze-arena/match-profile --filter @maze-arena/evaluation --filter @maze-arena/lineage --filter @maze-arena/evolution --filter @maze-arena/control-plane --filter @maze-arena/backup --filter @maze-arena/cli build && pnpm -r test",
    "typecheck": "pnpm --filter @maze-arena/contracts --filter @maze-arena/dsh-integration --filter @maze-arena/engine --filter @maze-arena/generator-plugin --filter @maze-arena/solver-plugin --filter @maze-arena/match-profile --filter @maze-arena/evaluation --filter @maze-arena/lineage --filter @maze-arena/evolution --filter @maze-arena/control-plane --filter @maze-arena/backup --filter @maze-arena/cli build && pnpm -r typecheck"
  }
}
